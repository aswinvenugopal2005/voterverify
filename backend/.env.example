# Security & JWT
SECRET_KEY=development_secret_key_change_in_production_min_32_chars_1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=sqlite:///./voter_verification.db

# Face Verification Settings
FACE_VERIFICATION_THRESHOLD=0.55
FACE_MODEL_NAME=Facenet
ENABLE_MOCK_FACE_IF_UNAVAILABLE=true

# Demo & Environment Settings
DEMO_OTP_MODE=true
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
